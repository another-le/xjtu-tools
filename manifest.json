{
    "name": "XJTU Tools",
    "description": "为西交学生提供成绩分析、教务辅助和学习资源下载功能。",
    "version": "1.1",
    "permissions": [
        "alarms",
        "cookies",
        "downloads",
        "notifications",
        "storage"
    ],
    "host_permissions": [
        "https://*.xjtu.edu.cn/*",
        "http://*.xjtu.edu.cn/*",
        "https://api.github.com/repos/another-le/xjtu-tools/*"
    ],
    "author": "le",
    "manifest_version": 3,
    "minimum_chrome_version": "127",
    "action": {
        "default_icon": "icon.png",
        "default_popup": "popup.html",
        "default_title": "XJTU Tools"
    },
    "background": {
        "service_worker": "scripts/background.js"
    },
    "icons": {
        "16": "icon.png",
        "32": "icon.png",
        "48": "icon.png",
        "64": "icon.png",
        "128": "icon.png"
    },
    "content_scripts": [
        {
            "matches": [
                "https://ehall.xjtu.edu.cn/jwapp/sys/cjcx/*default/*"
            ],
            "js": [
                "scripts/checkGrades.js"
            ],
            "css": [
                "checkGrades.css"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://ehall.xjtu.edu.cn/jwapp/sys/wspjyyapp/*default/*"
            ],
            "js": [
                "scripts/teachingEvaluation.js"
            ]
        },
        {
            "matches": [
                "https://xkfw.xjtu.edu.cn/xsxkapp/sys/xsxkapp/*default/index.do"
            ],
            "js": [
                "scripts/exit.js"
            ]
        },
        {
            "matches": [
                "https://lms.xjtu.edu.cn/course/*/*"
            ],
            "js": [
                "scripts/downloadResources.js"
            ],
            "run_at": "document_end"
        },
        {
            "matches": [
                "https://xjtu.yuketang.cn/pro/lms/*"
            ],
            "js": [
                "scripts/antiPause.js"
            ],
            "run_at": "document_start",
            "all_frames": true
        },
        {
            "matches": [
                "https://xkfw.xjtu.edu.cn/xsxkapp/sys/xsxkapp/*default/*"
            ],
            "js": [
                "scripts/watchCourse.js"
            ],
            "run_at": "document_end"
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "scripts/inject.js"
            ],
            "matches": [
                "https://xjtu.yuketang.cn/*"
            ]
        }
    ]
}
